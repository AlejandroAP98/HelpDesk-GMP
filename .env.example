# =============================================================================
# HelpDesk-GMP - Variables de entorno (Copiar a .env y ajustar)
# =============================================================================
# Generar claves secretas con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# ---------- Entorno ----------
APP_ENV=dev            # dev | prod
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@postgres:5432/helpdesk

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO (S3) ----------
MINIO_ROOT_USER=helpdesk
MINIO_ROOT_PASSWORD=helpdesk12345
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=helpdesk
MINIO_SECRET_KEY=helpdesk12345
MINIO_BUCKET=adjuntos
MINIO_USE_SSL=false

# ---------- JWT / Auth ----------
JWT_SECRET=cambia_esta_cadena_por_un_valor_largo_y_aleatorio_de_64_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30z
REFRESH_TOKEN_EXPIRE_DAYS=1
COOKIE_SECURE=false   # true en prod (HTTPS)

# ---------- Frontend (visible en el cliente) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Contáctenos WhatsApp: solo dígitos con código
# de país, sin "+" Vacíos = bloque oculto.
NEXT_PUBLIC_WHATSAPP_NUMERO=573001234567
NEXT_PUBLIC_CONTACTO_EMAIL=soporte@gmpredes.online

# ---------- Scheduler (cierre automático) ----------
TICKET_AUTO_CLOSE_DAYS=7
SCHEDULER_CLOSE_TICKETS_CRON=0 2 * * *      # 02:00 diarias

# ---------- Caddy (solo prod) ----------
SERVER_HOSTNAME=helpdesk.local

# ---------- Monitoring (solo prod) ----------
GRAFANA_PASSWORD=helpdesk   # Cambiar en prod
