VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@helpdesk.com

# Resend (emails transaccionales). Dejar RESEND_API_KEY vacio desactiva el envio.
# Lista de correos a notificar por tickets urgentes (separados por coma).
RESEND_API_KEY=
RESEND_FROM_EMAIL=HelpDesk <noreply@helpdesk.local>
RESEND_URGENT_RECIPIENTS=

# SLA. FRT: primera respuesta (todos). MTTR por elemento:
#   - Torre/Celda: 4h (sin importar la ciudad)
#   - Punto de venta con ciudad en SLA_CIUDADES_BASE: 24h (si no tiene ciudad registrada: 24h)
#   - Punto de venta con ciudad fuera de esa lista: 48h (remoto)
SLA_FRT_HORAS=0.5
SLA_MTTR_HORAS=24.0
SLA_MTTR_REMOTO_HORAS=48.0
SLA_MTTR_TORRE_CELDA_HORAS=4.0
SLA_CIUDADES_BASE=["Manizales", "Villamaría", "Chinchiná", "Neira", "Palestina", "Anserma", "Belalcázar", "Viterbo", "San José"]
