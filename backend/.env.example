VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@helpdesk.com

# Resend (emails transaccionales). Dejar RESEND_API_KEY vacio desactiva el envio.
# Lista de correos a notificar por tickets urgentes (separados por coma).
RESEND_API_KEY=
RESEND_FROM_EMAIL=HelpDesk <noreply@helpdesk.local>
RESEND_URGENT_RECIPIENTS=

# Telegram (alertas de grupo para mesa_ayuda/administrador, gratis via Bot API).
# Dejar TELEGRAM_BOT_TOKEN o TELEGRAM_CHAT_ID vacio desactiva el envio.
# Setup:
#   1. Crear bot con @BotFather -> copiar el token aqui.
#   2. Crear grupo (ej. "Soporte GMP Ops"), agregar al bot e invitar a
#      mesa_ayuda/administradores (escuchar mensajes del grupo requiere
#      privacy mode OFF: @BotFather -> /setprivacy -> Disable, o promocion
#      al bot como admin del grupo).
#   3. Escribir cualquier mensaje en el grupo y llamar
#      https://api.telegram.org/bot<TOKEN>/getUpdates para ver
#      result[].message.chat.id (negativo, ej. -1001234567890).
#   4. Reiniciar el backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zona horaria usada para bucketing de reportes (heatmaps, series diarias, SLA).
APP_TIMEZONE=America/Bogota

# SLA. FRT: primera respuesta (todos). MTTR medido en vivo con prioridad + elemento + ciudad:
#   - Prioridad MEDIA: 96h (4 dias).  BAJA: 144h (6 dias). Flat, ignora elemento/ciudad.
#   - URGENTE/ALTA aplica la matriz por elemento:
#       Torre/Celda: 4h (sin importar la ciudad)
#       Punto de venta con ciudad en SLA_CIUDADES_BASE (o sin ciudad): 24h
#       Punto de venta con ciudad fuera de esa lista: 48h (remoto)
# Regla de horario laboral: si el ticket se crea dentro de la franja
# SLA_HORA_INICIO_LABORAL .. SLA_HORA_FIN_LABORAL, el reloj arranca de inmediato
# y corre continuo. Si se crea fuera, arranca al proximo hora_inicio y desde ahi
# corre continuo (acuerdos con empresas: la madrugada sin atencion no cuenta).
SLA_FRT_HORAS=0.5
SLA_MTTR_HORAS=24.0
SLA_MTTR_REMOTO_HORAS=48.0
SLA_MTTR_TORRE_CELDA_HORAS=4.0
SLA_MTTR_MEDIA_HORAS=96.0
SLA_MTTR_BAJA_HORAS=144.0
SLA_CIUDADES_BASE=["Manizales", "Villamaría", "Chinchiná", "Neira", "Palestina", "Anserma", "Belalcázar", "Viterbo", "San José"]
SLA_HORA_INICIO_LABORAL=7
SLA_HORA_FIN_LABORAL=21
