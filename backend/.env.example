VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@helpdesk.com

# Resend (emails transaccionales). Dejar RESEND_API_KEY vacio desactiva el envio.
# Lista de correos a notificar por tickets urgentes (separados por coma).
RESEND_API_KEY=
RESEND_FROM_EMAIL=HelpDesk <noreply@helpdesk.local>
RESEND_URGENT_RECIPIENTS=

# SLA. Puntos de venta con ciudad fuera de SLA_CIUDADES_BASE usan el objetivo remoto.
SLA_FRT_HORAS=0.5
SLA_MTTR_HORAS=24.0
SLA_MTTR_REMOTO_HORAS=48.0
SLA_CIUDADES_BASE=["Manizales", "Villamaría"]
