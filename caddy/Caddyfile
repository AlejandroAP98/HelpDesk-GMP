{
	auto_https disable_redirects
}

:80 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	handle /minio/* {
		uri strip_prefix /minio
		reverse_proxy minio:9001
	}

	handle {
		reverse_proxy frontend:3000
	}
}

helpdesk.local {
	encode gzip zstd

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	handle /minio/* {
		uri strip_prefix /minio
		reverse_proxy minio:9001
	}

	handle {
		reverse_proxy frontend:3000
	}
}