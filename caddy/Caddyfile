{
	auto_https disable_redirects
}

:80 {
	encode gzip zstd

	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}

	@metrics_notlan {
		path /metrics
		not remote_ip 192.168.0.0/16
	}
	respond @metrics_notlan "Forbidden" 403

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /metrics {
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

helpdesk.local {
	encode gzip zstd

	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}

	@metrics_notlan {
		path /metrics
		not remote_ip 192.168.0.0/16
	}
	respond @metrics_notlan "Forbidden" 403

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /metrics {
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
